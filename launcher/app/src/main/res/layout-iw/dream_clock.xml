<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew screensaver: a large 24-hour clock centred over the screensaver artwork, with the brand and the RTL date below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Screensaver artwork, cropped to fill the screen. -->
    <ImageView
        android:id="@+id/dreamBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/screensaver"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dreamClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="160sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/dreamBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:text="@string/home_title"
            android:textColor="#8CFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.14" />

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:textDirection="rtl"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#66FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>
</FrameLayout>
